# ---- Rust ----
/target
**/target
*.pdb

# ---- Node / Vite ----
node_modules/
dist/
dist-ssr/
*.local
.vite/

# ---- Tauri ----
src-tauri/target/
src-tauri/gen/

# ---- macOS ----
.DS_Store

# ---- The operator's private content. THE hard rule of this repo. ----
# `.private-terms` is a denylist generated from the vault by scripts/gen-private-terms.sh and used
# by the pre-commit hook to block any commit containing a phrase from it. It must NEVER be
# committed — the denylist is itself the disclosure it exists to prevent.
.private-terms
/vault/
/my-vault/

# ---- Secrets. PRIV-4: credentials live in the macOS Keychain, never on disk. ----
.env
.env.*
!.env.example
*.pem
*.p12
credentials.json
client_secret*.json
token*.json
service-account*.json
gha-creds-*.json
*.key
*.keystore
.keychain-export*
secrets.toml
/.secrets/

# ---- Local state: caches and indexes are rebuildable, never authoritative (A-9) ----
*.db
*.db-shm
*.db-wal
*.sqlite
/data/
/cache/

# ---- Model assets: downloaded + checksum-verified at runtime, never committed (M-2) ----
/models/
*.gguf
*.onnx
*.bin

# ---- Audio. PRIV-1: audio never leaves the device — it also never lands in git. ----
*.wav
*.flac
/recordings/

# ---- mokata ----
# manifest.json and constitution.md ARE committed — they are the reviewable contract.
# Everything transient is not: pipeline state, resume checkpoints, the freshness index, caches,
# the SQLite memory store and the audit ledger. The memory store in particular can hold notes
# about this project's contents, so it never goes near a public repo.
.mokata/temp_local/

# Harness wiring generated by `mokata init`. NOT committed, because it hardcodes absolute paths
# to the machine it was generated on (`/opt/homebrew/bin/mokata-hook`, a versioned site-packages
# directory). Committed, those paths are wrong for every other contributor and for CI. Anyone
# working here runs `mokata init` and gets wiring that matches their own install.
# See docs/mokata.md.
.claude/
.mcp.json

# ---- Editors ----
.idea/
.vscode/*
!.vscode/extensions.json
