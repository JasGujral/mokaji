# Copy to .env for NON-SECRET configuration only.
#
# Credentials do NOT belong here — they live in the macOS Keychain (PRIV-4). See SECURITY.md for
# the service/account names. If you are about to paste a key or token into a .env file, stop.
#
# .env is gitignored; .env.example is committed. Keep them in sync.

# Absolute path to the Obsidian vault. Empty = auto-discover (H-3: an empty config must still boot
# to a working app against a discovered vault).
MOKAJI_VAULT_PATH=

# B-4: dry-run is the DEFAULT. Every intended vault mutation prints as a diff and applies nothing.
# Set to false only once you trust the write path, and only deliberately.
MOKAJI_VAULT_DRY_RUN=true

# PRIV-5: hard-disable all outbound traffic. Local-only operation stays fully functional (REL-2).
MOKAJI_NETWORK_ENABLED=true

# Where the rebuildable SQLite index lives (A-9 — a cache, never a source of truth).
MOKAJI_INDEX_PATH=./data/index.db

# trace | debug | info | warn | error. Logs record shapes, never contents — see SECURITY.md.
MOKAJI_LOG=info
